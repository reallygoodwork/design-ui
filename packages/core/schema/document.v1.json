	"description": "A design: its layers, breakpoints, tokens and editing rules",
	"$defs": {
		"Layer": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string",
					"minLength": 1
				},
				"name": {
					"type": "string"
				},
				"type": {
					"type": "string",
					"minLength": 1,
					"description": "A registered layer type, like text"
				},
				"value": {
					"type": "string",
					"description": "Text content, or an image's URL"
				},
				"cssVars": {
					"description": "Base styles, at the smallest breakpoint",
					"type": "object",
					"propertyNames": {
						"type": "string"
					},
					"additionalProperties": {
						"type": "string"
					}
				},
				"breakpointCssVars": {
					"description": "Only the styles each larger breakpoint overrides",
					"type": "object",
					"propertyNames": {
						"type": "string"
					},
					"additionalProperties": {
						"type": "object",
						"propertyNames": {
							"type": "string"
						},
						"additionalProperties": {
							"type": "string"
						},
						"description": "CSS custom properties, like { \"--font-size\": \"16px\" }"
					}
				},
				"meta": {
					"type": "object",
					"propertyNames": {
						"type": "string"
					},
					"additionalProperties": {}
				},
				"isLocked": {
					"type": "boolean"
				},
				"elementType": {
					"description": "The HTML element, like h1",
					"type": "string"
				},
				"children": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/Layer"
					}
				}
			},
			"required": [
				"id",
				"name",
				"type",
				"value"
			],
			"description": "A layer: a box, text or image, with its styles"
		}
