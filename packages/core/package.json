{
	"name": "@design-ui/core",
	"version": "0.1.0",
	"private": true,
	"description": "The design format: document types, actions, rules, validation, tokens and export, with no UI.",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"@design-ui/source": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./schema/document.v1.json": "./schema/document.v1.json"
	},
	"files": [
		"dist/**/*.js",
		"dist/**/*.d.ts",
		"schema/*.json"
	],
	"scripts": {
		"build": "vite build && tsc -p tsconfig.build.json"
	},
	"dependencies": {
		"culori": "^4.0.2",
		"zod": "^4"
	}
}
