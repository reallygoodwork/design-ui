{
	"name": "coral-design",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"agent": "bun agent/mcp-server.ts",
		"lint": "biome check . --error-on-warnings",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"test": "vitest run",
		"test:watch": "vitest",
		"schema": "bun packages/core/scripts/write-schema.ts",
		"build:css": "bun scripts/build-css.ts",
		"example:plain-host": "vite --config examples/plain-host/vite.config.ts"
	},
	"dependencies": {
		"@design-ui/core": "workspace:*",
		"@base-ui/react": "^1.9.0",
		"@tabler/icons-react": "^3.50.0",
		"@tailwindcss/vite": "^4.3.4",
		"@xyflow/react": "^12.12.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"culori": "^4.0.2",
		"lucide-react": "^0.562.0",
		"react": "^18.3.1",
		"react-aria-components": "^1.22.1",
		"react-dom": "^18.3.1",
		"react-infinite-viewer": "^0.28.1",
		"react-moveable": "^0.56.0",
		"react-selecto": "^1.26.3",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.4",
		"usehooks-ts": "^3.1.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.5",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/culori": "^4.0.1",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@types/ws": "^8.18.2",
		"@vitejs/plugin-react": "^4.7.0",
		"ajv": "^8.20.0",
		"jsdom": "^30.1.3",
		"typescript": "^5.9.3",
		"vite": "^5.4.21",
		"vitest": "^3.2",
		"ws": "^8.22.2",
		"zod": "^4"
	}
}
