{
	"name": "design-ui-smoke",
	"private": true,
	"version": "0.0.0",
	"description": "Installs the packed @design-ui tarballs like any app would, and checks they work. Run from the repo root: bun run smoke",
	"type": "module",
	"scripts": {
		"dev": "vite --port 5195 --strictPort",
		"build": "tsc --noEmit && vite build",
		"mcp": "design-ui-mcp"
	},
	"dependencies": {
		"@design-ui/core": "file:../../.packs/design-ui-core-0.1.0.tgz",
		"@design-ui/mcp": "file:../../.packs/design-ui-mcp-0.1.0.tgz",
		"@design-ui/react": "file:../../.packs/design-ui-react-0.1.0.tgz",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"overrides": {
		"@design-ui/core": "$@design-ui/core"
	},
	"devDependencies": {
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^4.3.4",
		"typescript": "^5.6.0",
		"vite": "^5.4.0"
	}
}
